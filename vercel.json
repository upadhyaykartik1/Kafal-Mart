{
  "version": 2,
  "builds": [
    {
      "src": "kafalmart-backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "kafalmart-frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "kafalmart-backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "kafalmart-frontend/$1"
    }
  ]
}
