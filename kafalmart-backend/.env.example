# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/kafalmart
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kafalmart
MONGO_URI=mongodb://127.0.0.1:27017/kafalmart

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# WhatsApp business number (used to build order links), digits only with country code
WHATSAPP_NUMBER=918439051530

# Allowed origin for CORS (your frontend URL)
CLIENT_URL=https://www.kafalmart.in
